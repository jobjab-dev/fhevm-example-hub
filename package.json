{
  "name": "fhevm-example-hub",
  "version": "1.0.0",
  "description": "Central hub for generating FHEVM example repositories",
  "type": "module",
  "bin": {
    "fhevm-examples": "dist/src/cli/index.js"
  },
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "tsc -p tsconfig.cli.json",
    "create": "node --loader ts-node/esm scripts/create-fhevm-example.ts",
    "create:category": "node --loader ts-node/esm scripts/create-fhevm-category.ts",
    "docs": "node --loader ts-node/esm scripts/generate-docs.ts",
    "validate": "node --loader ts-node/esm scripts/validate-example.ts",
    "validate:all": "node --loader ts-node/esm scripts/validate_all.ts",
    "test:all": "node --loader ts-node/esm scripts/validate_all.ts",
    "lint": "node --loader ts-node/esm scripts/validate-example.ts",
    "update:deps": "node --loader ts-node/esm scripts/update-deps.ts",
    "build:web": "cd app && npm run build",
    "dev:web": "cd app && npm run dev",
    "preview:web": "cd app && npm run preview",
    "start:cli": "node dist/cli/index.js"
  },
  "files": [
    "dist",
    "examples",
    "fhevm-hardhat-template",
    "example-catalog.json",
    "docs"
  ],
  "keywords": [
    "fhevm",
    "zama",
    "privacy",
    "blockchain"
  ],
  "author": "Antigravity",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.0.0",
    "fs-extra": "^11.1.1",
    "@types/fs-extra": "^11.0.1",
    "glob": "^10.3.10"
  },
  "dependencies": {
    "@clack/prompts": "^0.9.0",
    "chalk": "^5.4.0",
    "commander": "^13.0.0",
    "execa": "^9.5.2"
  }
}